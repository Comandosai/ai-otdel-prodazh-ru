# Конфиг с доступами к почте
config.json

# Готовые отчёты.
# Игнорируем содержимое, а не саму папку: git не умеет возвращать файл
# обратно, если исключена вся директория целиком.
out/*
!out/.gitkeep

# Базы конвейера
*.db
*.db-journal
*.sqlite
*.sqlite3

# Выгрузки из реестров
*.xlsx
*.xls
data/*
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Служебное
.DS_Store
*.log
.idea/
.vscode/

# Мусор синхронизации (Syncthing, Dropbox, iCloud).
# Без этих правил временные и конфликтные копии уезжают в репозиторий
# и человек, который его скачает, видит дубликаты файлов вместо чистого пака.
.syncthing.*
*.tmp
*sync-conflict*

# Служебное состояние инструментов разработки, к продукту отношения не имеет
.bkit/
.planning/
.agent/
